# Copy to backend/supabase/functions/.env for local Edge Function development.
# Local Supabase injects URL and local API keys when you run `supabase start`.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
DARAJA_CALLBACK_SECRET=
RESEND_API_KEY=
SCHOOL_FROM_EMAIL=School office <noreply@example.invalid>
