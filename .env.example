# Frontend public Supabase settings (safe in the browser; do not put a service key here).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Edge Function secrets belong in Supabase project secrets, never in VITE_ variables:
# MPESA_ENVIRONMENT=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://<project-ref>.supabase.co/functions/v1/daraja-callback?secret=<random-secret>
# DARAJA_CALLBACK_SECRET=<same-random-secret>
